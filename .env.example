# Copy this to .env (+ .env.local for the Razorpay section) and fill in real values.
# See README.md → "Deploying to Railway" for the full production checklist.

# --- DATABASE ---
# Local dev: from `npx prisma dev`. Production: Railway's Postgres connection string.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# Local dev only — NOT needed on Railway (prisma migrate deploy needs no shadow DB).
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51214/prisma_shadow?sslmode=disable"

# --- AUTH (NextAuth / Auth.js v5) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Optional — trustHost:true means this isn't strictly required, but recommended
# in production for a stable canonical URL (e.g. https://trinetraa.in).
AUTH_URL=""

# --- SEED SCRIPT (prisma/seed.ts) — one-time use, not needed by the running app ---
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""
ADMIN_PHONE=""

# --- RAZORPAY ---
# Dashboard → Settings → API Keys. Use rzp_test_... keys until you're ready to go live.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Dashboard → Settings → Webhooks → Add New Webhook → set a secret there, paste it here.
RAZORPAY_WEBHOOK_SECRET=""
